# Copy this file to `.env.local` and fill in your Supabase project details.
# Find these in your Supabase project: Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Powers Reading Practice's live passage generation (app/api/generate-passage,
# called automatically each time you start or replay a session — no manual
# steps) AND the optional scripts/generate-passages.mjs bulk-seed script.
# Server-only, never sent to the browser. Without this, Reading Practice
# just falls back to the curated text_bank pool. Get a free key:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — defaults to gemini-2.5-flash if unset.
# GEMINI_MODEL=gemini-2.5-flash

# Script-only, sensitive: Settings → API → service_role. Bypasses row-level
# security, so scripts/generate-passages.mjs can insert text_bank rows
# without a signed-in user session. Only needed if you run that script —
# the app itself never uses this. NEVER used client-side, never commit the
# real value.
SUPABASE_SERVICE_ROLE_KEY=

# Used only by scripts/generate-quickcalm-audio.js (Quick Calm narration).
# Get a key: https://elevenlabs.io
# ELEVENLABS_API_KEY=
