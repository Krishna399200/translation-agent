# Copy this file to `.env.local` and fill in your Supabase project details.
# Find these in your Supabase project: Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Used only by scripts/generate-passages.js — an offline batch script, never
# called during a live user session. Get a free key:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — defaults to gemini-2.5-flash if unset.
# GEMINI_MODEL=gemini-2.5-flash

# Script-only, sensitive: Settings → API → service_role. Bypasses row-level
# security, so scripts/generate-passages.js can insert text_bank rows
# without a signed-in user session. NEVER used by the app itself, never
# exposed to the browser, never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Used only by scripts/generate-quickcalm-audio.js (Quick Calm narration).
# Get a key: https://elevenlabs.io
# ELEVENLABS_API_KEY=
