# Copy this file to `.env.local` and fill in your Supabase project details.
# Find these in your Supabase project: Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Optional — enables dynamic, longer Reading Practice passages via Gemini.
# Server-only (no NEXT_PUBLIC_ prefix): never sent to the browser. Without
# this, Reading Practice falls back to the curated text_bank pool.
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — defaults to gemini-2.5-flash if unset.
# GEMINI_MODEL=gemini-2.5-flash
